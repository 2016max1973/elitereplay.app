# Server-only configuration; put real values in Vercel Production Secrets.
# Never copy the local Mac keychain helper or .env.local into the website.
ELITEREPLAY_MAIL_MODE=smtp
ELITEREPLAY_SMTP_HOST=smtps.udag.de
ELITEREPLAY_SMTP_PORT=465
ELITEREPLAY_SMTP_USER=
ELITEREPLAY_SMTP_PASSWORD=

# Preview deployments always simulate submission, even if SMTP variables exist.
# For local verification on port 4180, set ELITEREPLAY_MAIL_MODE=preview.

# Shared spam and duplicate-send protection (server-only, required for sending).
# Use one durable Redis database for all production instances, with eviction OFF.
# Keep the hash secret stable across deployments; generate at least 32 random bytes.
# Preview/local namespaces are separate; never use production credentials locally.
# Native Vercel Marketplace integration provides this pair automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Direct Upstash connections can instead use a complete
# UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN pair. Never mix pairs.
ELITEREPLAY_ENQUIRY_HASH_SECRET=
